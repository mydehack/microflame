# ==============================================================================
# FLAME IN FREEFALL — SCIENTIFIC RESEARCH & PROPULSION PLATFORM CONFIGURATION
# ==============================================================================

# 1. Supabase Database, Auth & Cloud Storage
# Configure in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. Groq AI Configuration for Scientific Research Bot & High-Speed Inference
# Obtain your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 3. NASA API & Scientific Gateway
NASA_API_KEY=DEMO_KEY

# 4. Backend Service Endpoints
BACKEND_PORT=8000
FASTAPI_BACKEND_URL=http://127.0.0.1:8000
